{
  "name": "hermes-mobile-client",
  "version": "1.0.3",
  "description": "Клиент протокола Hermes Mobile Adapter: подключение приложения, бота или веб-клиента к Hermes Agent по WebSocket (текст, медиа, карточки-вопросы, стриминг)",
  "license": "MIT",
  "type": "module",
  "main": "dist/cjs/hermesClient.js",
  "module": "dist/esm/hermesClient.js",
  "types": "dist/esm/hermesClient.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/hermesClient.d.ts",
      "import": "./dist/esm/hermesClient.js",
      "require": "./dist/cjs/hermesClient.js",
      "default": "./dist/esm/hermesClient.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "hermesClient.ts", "package.json", "README.md"],
  "keywords": [
    "hermes",
    "hermes-agent",
    "websocket",
    "mobile",
    "react-native",
    "expo",
    "chat",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geniok1980/hermes-mobile-adapter.git"
  },
  "homepage": "https://github.com/geniok1980/hermes-mobile-adapter#readme",
  "bugs": {
    "url": "https://github.com/geniok1980/hermes-mobile-adapter/issues"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && node scripts/postbuild.mjs",
    "build:esm": "tsc hermesClient.ts --outDir dist/esm --declaration --target ES2020 --module ES2020 --moduleResolution bundler --skipLibCheck",
    "build:cjs": "tsc hermesClient.ts --outDir dist/cjs --declaration --target ES2020 --module CommonJS --skipLibCheck",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution bundler hermesClient.ts"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
